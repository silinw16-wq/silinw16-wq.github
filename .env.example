# Export these variables in your shell; .env is not loaded automatically.
SKILL_BOWL_SKILLS_DIR=/absolute/path/to/private/skills
SKILL_BOWL_API_TOKEN=replace-with-a-long-random-token
MODEL_API_URL=https://your-provider.example/v1/chat/completions
MODEL_NAME=your-model
MODEL_API_KEY=configure-locally
MODEL_TIMEOUT_SECONDS=30
# MCP tokens must be distinct from each other and the REST token (24+ characters).
SKILL_BOWL_MCP_RUN_TOKEN=replace-with-a-separate-random-run-token
# Optional: can discover tools/list skills, cannot execute Skill/model calls.
SKILL_BOWL_MCP_READ_TOKEN=replace-with-a-separate-random-read-token
# For remote deployment, explicitly configure trusted Host/Origin values.
SKILL_BOWL_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
SKILL_BOWL_MCP_ALLOWED_ORIGINS=
