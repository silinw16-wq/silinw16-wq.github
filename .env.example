SKILL_BOWL_API_TOKEN=replace-with-a-long-random-token
MODEL_API_URL=https://your-provider.example/v1/chat/completions
MODEL_NAME=your-model
MODEL_API_KEY=configure-locally
MODEL_TIMEOUT_SECONDS=30
